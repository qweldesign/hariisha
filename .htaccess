# サイト全体の設定 (Apache)

# 設定ファイルは直接公開しない
<Files "config.php">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www なしの URL に揃える
  RewriteCond %{HTTP_HOST} ^www\.hariisha\.jp$ [NC]
  RewriteRule ^(.*)$ https://hariisha.jp/$1 [R=301,L]

  # サイトのルートの URL (例: /tools/simple-cms/) を BASE に入れる
  RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
  RewriteRule ^(.*)$ - [E=BASE:%1]

  # サイトマップは sitemap.php が content/ から自動で作る
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
