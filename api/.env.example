# お問い合わせフォームの設定
# このファイルを .env という名前でコピーし、値を書き換えて使う。
# .env にはパスワードが含まれるため、Git には含めない（.gitignore 済み）。

# ---- サイト設定 ----
SITE_TITLE="海辺の古民家はりいしゃ"
# Origin / Referer チェックに使う（末尾のスラッシュなし）
# www 付きでも公開する場合は、どちらかに転送して表記を揃えること
SITE_URL="https://hariisha.jp"
# 送信元・管理者宛の通知先（TODO: 実際の受付アドレスに差し替え）
ADMIN_EMAIL="info@hariisha.jp"

# ---- SMTP 設定（TODO: 契約するサーバーの値に差し替え）----
SMTP_HOST="smtp.example.com"
SMTP_USER="info@hariisha.jp"
SMTP_PASS="********"
SMTP_PORT=587
# tls（STARTTLS, 通常は 587 番）、ssl（SMTPS, 通常は 465 番）、none（暗号化なし。ローカルのテスト用のみ）
SMTP_SECURE=tls

# ---- 項目設定 ----
# 必須項目の name 属性（カンマ区切り）。index.html のフォームの required と揃える
REQUIRED_FIELDS="お名前,メールアドレス,件名"
# メールアドレス入力欄の name 属性
EMAIL_FIELD="メールアドレス"

# ---- 自動返信メールの署名 ----
# ダブルクォートの中は改行をそのまま書ける
MAIL_FOOTER="
内容を確認のうえ、折り返しご連絡いたします。今しばらくお待ちください。

────────────────────────────────────────────────
海辺の古民家はりいしゃ
〒910-3553 福井県福井市蒲生町1-42
https://hariisha.jp

運営：福井市越前海岸盛り上げ隊
────────────────────────────────────────────────
"
